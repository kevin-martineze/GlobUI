{
  "name": "glob-ui",
  "private": true,
  "scripts": {
    "dev": "pnpm build:packages && pnpm dev:watch",
    "dev:watch": "pnpm -r --parallel --filter \"./packages/*\" --filter docs run dev",
    "dev:docs": "pnpm dev",
    "build": "pnpm build:packages && pnpm check:directives && pnpm build:docs",
    "build:packages": "pnpm -r --filter @glob-ui/* run build",
    "build:docs": "pnpm --filter docs build && node apps/docs/scripts/check-docs.mjs",
    "check:docs": "node apps/docs/scripts/check-docs.mjs",
    "check:directives": "node scripts/check-client-directives.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "sync:packages": "node scripts/sync-package-meta.mjs",
    "start": "pnpm --filter docs start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "release": "changeset publish",
    "version": "changeset version",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.65.0",
    "publint": "^0.3.25",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  },
  "packageManager": "pnpm@12.11.2"
}
