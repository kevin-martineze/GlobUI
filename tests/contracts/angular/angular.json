{
  "$schema": "../../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "contracts": {
      "projectType": "application",
      "root": ".",
      "sourceRoot": ".",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "main.ts",
            "tsConfig": "tsconfig.json",
            "outputPath": "../../../node_modules/.cache/contracts-angular",
            "styles": [
              "styles.css"
            ]
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.json",
            "buildTarget": "contracts:build:development",
            "runner": "vitest",
            "browsers": [
              "chromium"
            ],
            "include": [
              "angular.browser.test.ts"
            ],
            "setupFiles": [
              "setup.ts"
            ],
            "watch": false
          }
        }
      }
    }
  }
}
