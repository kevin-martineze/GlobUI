{
  "name": "@glob-ui/all",
  "version": "0.1.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@glob-ui/accordion": "workspace:*",
    "@glob-ui/alert": "workspace:*",
    "@glob-ui/alert-dialog": "workspace:*",
    "@glob-ui/avatar": "workspace:*",
    "@glob-ui/badge": "workspace:*",
    "@glob-ui/button": "workspace:*",
    "@glob-ui/card": "workspace:*",
    "@glob-ui/checkbox": "workspace:*",
    "@glob-ui/dialog": "workspace:*",
    "@glob-ui/dropdown-menu": "workspace:*",
    "@glob-ui/field": "workspace:*",
    "@glob-ui/hooks": "workspace:*",
    "@glob-ui/input": "workspace:*",
    "@glob-ui/label": "workspace:*",
    "@glob-ui/multi-select": "workspace:*",
    "@glob-ui/phone-input": "workspace:*",
    "@glob-ui/popover": "workspace:*",
    "@glob-ui/progress": "workspace:*",
    "@glob-ui/radio-group": "workspace:*",
    "@glob-ui/segmented": "workspace:*",
    "@glob-ui/select": "workspace:*",
    "@glob-ui/separator": "workspace:*",
    "@glob-ui/sheet": "workspace:*",
    "@glob-ui/skeleton": "workspace:*",
    "@glob-ui/slider": "workspace:*",
    "@glob-ui/slot": "workspace:*",
    "@glob-ui/spinner": "workspace:*",
    "@glob-ui/switch": "workspace:*",
    "@glob-ui/tabs": "workspace:*",
    "@glob-ui/textarea": "workspace:*",
    "@glob-ui/toast": "workspace:*",
    "@glob-ui/toggle": "workspace:*",
    "@glob-ui/tooltip": "workspace:*",
    "@glob-ui/utils": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "description": "Every GlobUI component in one package.",
  "keywords": [
    "react",
    "glob-ui",
    "components",
    "accessible",
    "tailwind",
    "bundle",
    "all"
  ],
  "license": "MIT",
  "author": "Kevin Martínez E",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevin-martineze/GlobUI.git",
    "directory": "packages/all"
  },
  "homepage": "https://github.com/kevin-martineze/GlobUI#readme",
  "bugs": {
    "url": "https://github.com/kevin-martineze/GlobUI/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "type": "commonjs",
  "engines": {
    "node": ">=18.18"
  }
}
